# ==============================================================
# MediCare Platform Backend Environment Configuration (.env.example)
# ==============================================================

# Server
PORT=8080
NODE_ENV=development

# Database
# Provide your MongoDB connection string (local or MongoDB Atlas)
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/doc-appointment?retryWrites=true&w=majority

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min32chars
ADMIN_SECRET=your_secure_admin_provision_passcode_min32chars
ADMIN_EMAIL=admin@medicare.local
ADMIN_PASSWORD=your_strong_admin_password_min12chars

# Client URLs (for CORS allowlist)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# High-Performance Distributed Caching & Rate-Limiting (Optional)
# If REDIS_URL is omitted or unreachable, system automatically runs with in-memory fallback
REDIS_URL=redis://localhost:6379

# AI Healthcare Assistant (MediAssist AI)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Online Payment Gateway (Razorpay) - Test Mode
# Obtain from Razorpay Dashboard: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test
